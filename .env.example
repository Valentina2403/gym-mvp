# Copia este archivo como .env y ajusta los valores.

# Clave para firmar sesiones. En producción usa un valor largo y aleatorio.
SECRET_KEY=cambie-esta-clave-en-produccion

# Entorno: development | production
FLASK_ENV_NAME=development

# Base de datos. Si no se define, se usa SQLite en instance/gimnasio.db
# MySQL: DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/gimnasio
# DATABASE_URL=

# Días antes del vencimiento en que una membresía pasa a "Por vencer".
DIAS_AVISO_VENCIMIENTO=7
